---
import Img from "./Img.astro";
import Title from "./Title.astro";
import type { PageText } from "../lib/content";

/**
 * Inner-page hero: keyword line (inside the H1, for SEO), headline + bronze part,
 * intro text + buttons on the right, optional wide photo below. All text comes
 * from the page's CMS entry (fields heroKeyword, heroHeadline, heroAccent,
 * heroSub, heroImage — see src/data/pages.ts).
 */
interface Props {
  page: PageText;
  no?: string;
  image?: ImageMetadata;
  alt?: string;
}
const { page, no = "01", image, alt = "" } = Astro.props;
const sub = page.t("heroSub");
const cmsImage = page.image("heroImage");
---

<section class="page-hero">
  <div class="container">
    <div class="page-hero__grid">
      <div>
        <h1 class="h1 page-hero__title words" data-words>
          <span class="eyebrow h1-kicker" data-static>
            <span class="eyebrow__no" aria-hidden="true">({no})</span>
            <span>{page.t("heroKeyword")}</span>
          </span>
          <Title head={page.t("heroHeadline")} accent={page.t("heroAccent")} />
        </h1>
      </div>
      <div class="page-hero__aside">
        {sub && <p class="lede" data-reveal style="--delay: 200ms">{sub}</p>}
        <div class="btn-row" data-reveal style="--delay: 280ms">
          <slot name="actions" />
        </div>
      </div>
    </div>

    {
      cmsImage ? (
        <div class="page-hero__media" data-reveal="scale">
          <div class="media">
            <img src={cmsImage} alt={alt} loading="eager" decoding="async" width="2000" height="857" />
          </div>
        </div>
      ) : (
        image && (
          <div class="page-hero__media" data-reveal="scale">
            <div class="media">
              <Img src={image} alt={alt} sizes="(max-width: 1264px) 100vw, 1200px" loading="eager" />
            </div>
          </div>
        )
      )
    }
  </div>
</section>
