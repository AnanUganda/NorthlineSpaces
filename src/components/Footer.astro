---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { nav, href } from "../data/site";
import { getContent } from "../lib/content";

const { business, site } = await getContent();

const year = new Date().getFullYear();
const sitemapA = nav.slice(0, 5);
const sitemapB = nav.slice(5);
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a class="brand" href={href("")} aria-label="Northline Spaces home">
          <Logo class="brand__mark" />
          <span class="brand__text">
            <span class="brand__name">{business.wordmark}</span>
            <span class="brand__sub">{business.tagline}</span>
          </span>
        </a>
        <p class="footer__desc">
          {site.footerBlurb}
        </p>
        <address class="footer__addr">
          {business.town}, {business.state}<br />
          Serving {business.area}
          {business.phone && <><br /><a href={`tel:${business.phone.replace(/[^0-9+]/g, "")}`}>{business.phone}</a></>}
          {business.email && <><br /><a href={`mailto:${business.email}`}>{business.email}</a></>}
          <br />{business.hours}
        </address>
      </div>

      <div class="footer__col">
        <p class="footer__h">Sitemap</p>
        <ul>
          {sitemapA.map((n) => <li><a href={href(n.slug)}>{n.label}</a></li>)}
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__h">More</p>
        <ul>
          {sitemapB.map((n) => <li><a href={href(n.slug)}>{n.label}</a></li>)}
        </ul>
      </div>

      <div class="footer__cta">
        <p class="label faint">Get a quote</p>
        <p>Tell us what you need. We'll respond within {business.callbackMinutes} minutes during business hours with your price.</p>
        <Button href={href("quote")} label="Get My Free Quote" size="sm" />
        <a class="footer__contact" href={href("contact")}>Or contact us <Icon name="arrow-right" /></a>
      </div>
    </div>

    <div class="footer__bar">
      <span>&copy; {year} {business.name}. All rights reserved.</span>
      <nav aria-label="Legal">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#top" class="footer__top">
          Back to top <Icon name="arrow-up" />
        </a>
      </nav>
    </div>

    <div class="footer__wordmark" aria-hidden="true">Northline</div>
  </div>
</footer>
