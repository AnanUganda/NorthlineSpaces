---
import Img from "../components/Img.astro";
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SizeTable from "../components/SizeTable.astro";
import Faq from "../components/Faq.astro";
import Title from "../components/Title.astro";
import { images, href, audiences } from "../data/site";
import { getContent, getPage } from "../lib/content";

const content = await getContent();
const { homeFaq, business } = content;
const { t, items, image } = await getPage("home");

const n3 = [1, 2, 3];
const n4 = [1, 2, 3, 4];
const icons = ["clock", "tag", "shield", "thermo"] as const;

const stats = n4.map((i) => ({
  no: `0${i}`,
  value: t(`stat${i}Value`),
  unit: i === 1 ? t("stat1Unit") : "",
  label: t(`stat${i}Label`),
  sub: t(`stat${i}Sub`),
  icon: icons[i - 1],
}));

// Service cards: the copy comes from the CMS; slug + photo stay with the code.
const services = audiences.map((a, i) => ({
  ...a,
  title: t(`service${i + 1}Title`),
  short: t(`service${i + 1}Short`),
  blurb: t(`service${i + 1}Text`),
  tags: items(`service${i + 1}Tags`),
}));
const heroImage = image("heroImage");

const work = [
  {
    span: "span-7",
    ratio: "media--4x3",
    image: images.unitOpenInterior,
    alt: "Northline unit with the roll-up door open, showing the lit, wood-lined interior",
    title: t("photo1Title"),
    year: t("photo1Tag"),
    desc: t("photo1Text"),
    chips: items("photo1Chips"),
  },
  {
    span: "span-5",
    ratio: "media--3x4",
    image: images.detailBadgeTrim,
    alt: "Close-up of the cedar-tone trim and Northline badge on the unit",
    title: t("photo2Title"),
    year: t("photo2Tag"),
    desc: t("photo2Text"),
    chips: items("photo2Chips"),
  },
  {
    span: "span-5",
    ratio: "media--1x1",
    image: images.estateAerial,
    alt: "Aerial view of a Northline unit on the paved courtyard of a hillside estate",
    title: t("photo3Title"),
    year: t("photo3Tag"),
    desc: t("photo3Text"),
    chips: items("photo3Chips"),
  },
  {
    span: "span-7",
    ratio: "media--4x3",
    image: images.unitStudioAngle,
    alt: "Three-quarter view of a Northline unit showing the window and walk-in side door",
    title: t("photo4Title"),
    year: t("photo4Tag"),
    desc: t("photo4Text"),
    chips: items("photo4Chips"),
  },
];
---

<Layout slug="" light>
  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <div class="hero__frame">
      <div class="hero__media">
        {heroImage ? (
          <img src={heroImage} alt="" loading="eager" fetchpriority="high" decoding="async" />
        ) : (
        <Img
          src={images.heroDriveway}
          alt="A Northline portable storage unit parked on the paver driveway of a modern farmhouse at golden hour"
          widths={[900, 1400, 2000, 2400]}
          sizes="100vw"
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
        )}
      </div>
      <div class="hero__grid" aria-hidden="true">
        <span class="hero__cross" style="left: 25%; top: 25%"></span>
        <span class="hero__cross" style="left: 75%; top: 25%"></span>
        <span class="hero__cross" style="left: 50%; top: 50%"></span>
        <span class="hero__cross" style="left: 25%; top: 75%"></span>
        <span class="hero__cross" style="left: 75%; top: 75%"></span>
      </div>

      <div class="hero__body">
        <h1 class="h1 hero__title words" data-words>
          <span class="eyebrow h1-kicker" data-static>
            <span>{t("heroKeyword")}</span>
          </span>
          <Title head={t("heroHeadline")} accent={t("heroAccent")} />
        </h1>
        <p class="hero__sub" data-reveal style="--delay: 450ms">{t("heroSub")}</p>
        <div class="btn-row hero__actions" data-reveal style="--delay: 560ms">
          <Button href={href("quote")} label="Get My Free Quote" variant="light" />
          <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
        </div>

        <a class="hero__card" href={href("unit")} data-reveal style="--delay: 700ms">
          <div class="media">
            <Img src={images.unitStudioFront} alt="" widths={[128, 256]} sizes="64px" format="webp" quality={70} />
          </div>
          <div>
            <div class="hero__card-label">{t("heroCardLabel")}</div>
            <div class="hero__card-title">{t("heroCardTitle")}</div>
            <div class="hero__card-meta">{business.town}, {business.state} — {business.founded}</div>
          </div>
          <Icon name="arrow-up-right" />
        </a>
      </div>

      <div class="hero__strip">
        {
          services.map((a) => (
            <a href={href(a.slug)}>
              <span class="hero__strip-label">
                <span class="index">({a.index})</span>
                {a.short}
              </span>
              <Icon name="arrow-up-right" class="hero__strip-arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== The guide ===================== -->
  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="01" label={t("aboutLabel")} />
          <h2 class="h2" data-reveal><Title head={t("aboutHeading")} accent={t("aboutAccent")} /></h2>
        </div>
        <p class="intro" data-reveal>{t("aboutText")}</p>
      </div>

      <div class="stats mt-5" data-reveal>
        {
          stats.map((s) => (
            <div class="stat">
              <span class="stat__no">{s.no}</span>
              <Icon name={s.icon} class="stat__icon" />
              <div class="stat__value">
                {s.value}
                {s.unit && <span style="font-size: 0.4em; letter-spacing: -0.02em; margin-left: 0.15em">{s.unit}</span>}
              </div>
              <div>
                <div class="stat__label">{s.label}</div>
                <div class="stat__sub">{s.sub}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Services ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="02" label={t("servicesLabel")} />
          <h2 class="h2" data-reveal><Title head={t("servicesHeading")} accent={t("servicesAccent")} /></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">{t("servicesText")}</p>
      </div>

      <div class="svc" data-reveal>
        {
          services.map((a, i) => (
            <article class:list={["svc__item", { "is-open": i === 0 }]} tabindex="0" aria-label={a.title}>
              <Img src={a.image} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 900px" format="webp" quality={70} />
              <div class="svc__collapsed">
                <span>
                  <span class="index">({a.index})</span>
                  {a.title}
                </span>
              </div>
              <div class="svc__open">
                <span class="svc__tag">({a.index})</span>
                <h3 class="svc__title">{a.title}</h3>
                <p class="svc__desc">{a.blurb}</p>
                <div class="svc__foot">
                  <span>{a.tags.join(" · ")}</span>
                  <a class="link" href={href(a.slug)}>
                    Explore <Icon name="arrow-right" />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== The unit ===================== -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label={t("unitLabel")} />
          <h2 class="h2" data-reveal><Title head={t("unitHeading")} accent={t("unitAccent")} /></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <a class="link" href={href("unit")}>See the unit <Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="feature-list mb-4" data-reveal>
        {
          n3.map((i) => (
            <div class="feature">
              <span class="index">(0{i})</span>
              <div>
                <h3 class="feature__title">{t(`benefit${i}Title`)}</h3>
                <p class="feature__desc">{t(`benefit${i}Text`)}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="masonry">
        {
          work.map((w, i) => (
            <a class:list={["work", w.span]} href={href("unit")} data-reveal="scale" style={`--delay: ${(i % 2) * 90}ms`}>
              <div class:list={["media", "media--hover", "work__media", w.ratio]}>
                <Img src={w.image} alt={w.alt} widths={[700, 1100, 1500]} sizes="(max-width: 860px) 100vw, 700px" format="webp" quality={72} />
                <span class="img-btn">
                  <Icon name="arrow-up-right" />
                </span>
              </div>
              <div class="work__row">
                <span class="work__title">{w.title}</span>
                <span class="work__year">{w.year}</span>
              </div>
              <p class="work__desc">{w.desc}</p>
              <div class="chips">{w.chips.map((c) => <span class="chip">{c}</span>)}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Sizes & pricing ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="04" label={t("pricingLabel")} />
          <h2 class="h2" data-reveal><Title head={t("pricingHeading")} accent={t("pricingAccent")} /></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede mb-2">{t("pricingText")}</p>
          <Button href={href("pricing")} label="See full pricing" variant="outline" size="sm" />
        </div>
      </div>

      <SizeTable mode="both" />
      <p class="small muted mt-2" data-reveal>{t("pricingNote")}</p>
    </div>
  </section>

  <!-- ===================== Process (dark) ===================== -->
  <section class="section section--dark process">
    <div class="process__bg" aria-hidden="true">
      <Img src={images.unitOpenInterior} alt="" widths={[1200, 1800]} sizes="100vw" format="webp" quality={55} />
    </div>
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="05" label={t("stepsLabel")} />
          <h2 class="h2" data-reveal><Title head={t("stepsHeading")} accent={t("stepsAccent")} /></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede muted mb-2">{t("stepsText")}</p>
          <Button href={href("quote")} label="Get My Free Quote" variant="light" size="sm" />
        </div>
      </div>

      <div class="steps">
        {
          n3.map((i) => (
            <div class="step" data-reveal style={`--delay: ${(i - 1) * 80}ms`}>
              <span class="step__no">
                <Icon name="arrow-right" /> 0{i}.
              </span>
              <h3 class="step__title">{t(`step${i}Title`)}</h3>
              <p class="step__desc">{t(`step${i}Text`)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Beliefs ===================== -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="06" label={t("beliefsLabel")} />
          <h2 class="h2" data-reveal><Title head={t("beliefsHeading")} accent={t("beliefsAccent")} /></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede mb-2">{t("beliefsText")}</p>
          <a class="link" href={href("about")}>Our story <Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="feature-list" data-reveal>
        {
          n3.map((i) => (
            <div class="feature">
              <span class="index">(0{i})</span>
              <div>
                <h3 class="feature__title">{t(`belief${i}Title`)}</h3>
                <p class="feature__desc">{t(`belief${i}Text`)}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Success + stakes ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head section-head--stack">
        <div>
          <Eyebrow no="07" label={t("outcomesLabel")} />
          <h2 class="h2" data-reveal><Title head={t("outcomesHeading")} accent={t("outcomesAccent")} /></h2>
        </div>
      </div>
      <div class="outcomes" data-reveal>
        <div class="outcomes__with">
          <p class="label">{t("withLabel")}</p>
          <ul class="reasons">
            {n4.map((i) => t(`with${i}`)).filter(Boolean).map((x) => <li class="reason"><span>{x}</span></li>)}
          </ul>
          <div class="mt-3">
            <Button href={href("quote")} label="Get My Free Quote" size="sm" />
          </div>
        </div>
        <div class="outcomes__without">
          <p class="label faint">{t("withoutLabel")}</p>
          <ul>
            {n3.map((i) => t(`without${i}`)).filter(Boolean).map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="08" label={t("faqLabel")} />
          <h2 class="h2 mb-2" data-reveal><Title head={t("faqHeading")} accent={t("faqAccent")} /></h2>
          <p class="lede mb-2" data-reveal style="--delay: 80ms">{t("faqText")}</p>
          <a class="link" href={href("faq")} data-reveal style="--delay: 140ms">
            Ask us anything <Icon name="arrow-right" />
          </a>
        </div>
        <Faq items={homeFaq} />
      </div>
    </div>
  </section>
</Layout>
