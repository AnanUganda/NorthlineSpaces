---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import { href } from "../data/site";
import { getContent, getPage } from "../lib/content";

const { faq } = await getContent();

const page = await getPage("faq");
const { t } = page;
---

<Layout slug="faq">
  <PageHero
    page={page}
  >
    <Fragment slot="actions">
      <Button variant="accent" href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div></div>
        <Faq groups={faq} />
      </div>
    </div>
  </section>
</Layout>
