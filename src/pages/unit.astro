---
import Img from "../components/Img.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SizeTable from "../components/SizeTable.astro";
import { images, href } from "../data/site";
import { getContent, getPage } from "../lib/content";

const { features } = await getContent();

const page = await getPage("unit");
const { t } = page;
---

<Layout slug="unit">
  <PageHero
    page={page}
    image={images.unitOpenInterior}
    alt="A Northline unit with its roll-up door open, showing the lit, wood-lined, insulated interior"
  >
    <Fragment slot="actions">
      <Button href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <!-- Designed for beautiful homes -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="02" label={t("designLabel")} />
          <h2 class="h2" data-reveal><Title head={t("designHeading")} accent={t("designAccent")} /></h2>
        </div>
        <div>
          <p class="intro mb-4" data-reveal>{t("designIntro")}</p>
          <p class="lede mb-4" data-reveal style="--delay: 80ms">{t("designText")}</p>
          <div class="media media--4x3 media--hover" data-reveal="scale">
            <Img src={images.detailBadgeTrim} alt="Close-up of the cedar-tone trim, fasteners and Northline badge" widths={[700, 1100, 1500]} sizes="(max-width: 860px) 100vw, 700px" format="webp" quality={72} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Insulated -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label={t("insulatedLabel")} />
          <h2 class="h2" data-reveal><Title head={t("insulatedHeading")} accent={t("insulatedAccent")} /></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">{t("insulatedText")}</p>
      </div>
      <div class="reasons" data-reveal>
        {[1, 2, 3, 4].map((i) => t(`protect${i}`)).filter(Boolean).map((x) => <div class="reason"><span>{x}</span></div>)}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="04" label={t("featuresLabel")} />
          <h2 class="h2" data-reveal><Title head={t("featuresHeading")} accent={t("featuresAccent")} /></h2>
        </div>
        <table class="table table--2" data-reveal>
          <thead>
            <tr><th>Feature</th><th>What it means for you</th></tr>
          </thead>
          <tbody>
            {features.map((f) => <tr><td>{f.feature}</td><td>{f.benefit}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Sizes -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="05" label={t("sizesLabel")} />
          <h2 class="h2" data-reveal><Title head={t("sizesHeading")} accent={t("sizesAccent")} /></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">{t("sizesText")}</p>
      </div>
      <SizeTable mode="both" />
    </div>
  </section>

  <!-- Placed with care -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div>
          <Eyebrow no="06" label={t("placedLabel")} />
          <h2 class="h2" data-reveal><Title head={t("placedHeading")} accent={t("placedAccent")} /></h2>
        </div>
        <div>
          <p class="lede mb-3" data-reveal>{t("placedText")}</p>
          <div data-reveal style="--delay: 80ms">
            <Button href={href("quote")} label="Get My Free Quote" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
