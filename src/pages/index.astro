---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SizeTable from "../components/SizeTable.astro";
import Faq from "../components/Faq.astro";
import {
  images,
  href,
  audiences,
  beliefs,
  process,
  homeFaq,
  business,
} from "../data/site";

const stats = [
  { no: "01", value: "15", unit: "min", label: "To a real person", sub: "We call back with your price", icon: "clock" },
  { no: "02", value: "$99", unit: "", label: "Delivery & pickup", sub: "Within 10 miles of Fallbrook", icon: "tag" },
  { no: "03", value: "3", unit: "", label: "Sizes", sub: "8×12, 8×16 and 8×20", icon: "shield" },
  { no: "04", value: "0", unit: "", label: "Hidden fees", sub: "The price you see is the price you pay", icon: "thermo" },
] as const;

const work = [
  {
    span: "span-7",
    ratio: "media--4x3",
    image: images.unitOpenInterior,
    alt: "Northline unit with the roll-up door open, showing the lit, wood-lined interior",
    title: "Walk right in",
    year: "Interior",
    desc: "Ground-level loading through a wide roll-up door. Lit, lined and insulated inside.",
    chips: ["Roll-up door", "Insulated", "Ground level"],
  },
  {
    span: "span-5",
    ratio: "media--3x4",
    image: images.detailBadgeTrim,
    alt: "Close-up of the cedar-tone trim and Northline badge on the unit",
    title: "Built like it's meant to stay",
    year: "Detail",
    desc: "Charcoal ribbed siding, warm cedar-tone trim, clean simple lines.",
    chips: ["Cedar-tone trim", "Ribbed siding"],
  },
  {
    span: "span-5",
    ratio: "media--1x1",
    image: images.unitStudioFront,
    alt: "Front elevation of a Northline storage unit",
    title: "Handsome from the street",
    year: "Front",
    desc: "Designed to sit in front of a beautiful home without looking out of place.",
    chips: ["Secure locking", "Weatherproof"],
  },
  {
    span: "span-7",
    ratio: "media--4x3",
    image: images.unitStudioAngle,
    alt: "Three-quarter view of a Northline unit showing the window and walk-in side door",
    title: "Window and side door",
    year: "Select sizes",
    desc: "Natural light to see what you're doing, and a walk-in door so you can grab something without opening the main one.",
    chips: ["Window", "Side door", "8×16 · 8×20"],
  },
];
---

<Layout slug="" light>
  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <div class="hero__frame">
      <div class="hero__media">
        <Image
          src={images.heroDriveway}
          alt="A Northline portable storage unit parked on the paver driveway of a modern farmhouse at golden hour"
          widths={[900, 1400, 2000, 2400]}
          sizes="100vw"
          format="webp"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero__grid" aria-hidden="true">
        <span class="hero__cross" style="left: 25%; top: 25%"></span>
        <span class="hero__cross" style="left: 75%; top: 25%"></span>
        <span class="hero__cross" style="left: 50%; top: 50%"></span>
        <span class="hero__cross" style="left: 25%; top: 75%"></span>
        <span class="hero__cross" style="left: 75%; top: 75%"></span>
      </div>

      <div class="hero__body">
        <h1 class="h1 hero__title words" data-words>
          Storage that looks like it belongs.
        </h1>

        <a class="hero__card" href={href("unit")} data-reveal style="--delay: 700ms">
          <div class="media">
            <Image src={images.unitStudioFront} alt="" widths={[128, 256]} sizes="64px" format="webp" quality={70} />
          </div>
          <div>
            <div class="hero__card-label">Most popular</div>
            <div class="hero__card-title">8×16 insulated unit</div>
            <div class="hero__card-meta">{business.town}, {business.state} — {business.founded}</div>
          </div>
          <Icon name="arrow-up-right" />
        </a>
      </div>

      <div class="hero__strip">
        {
          audiences.map((a) => (
            <a href={href(a.slug)}>
              <span class="index">({a.index})</span>
              {a.short}
            </a>
          ))
        }
        <span class="hero__scroll">Scroll to explore</span>
      </div>
    </div>
  </section>

  <!-- ===================== About / intro ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="01" label="About Northline" />
          <p class="label accent" data-reveal>Now delivering across {business.area}</p>
        </div>
      </div>

      <div class="split">
        <div></div>
        <p class="intro" data-reveal>
          Most portable storage is a metal box. Ours is closer to a small,
          well-built room — insulated, secure and handsome enough for any
          driveway. We're a {business.town} family, and we build storage we'd be
          proud to park in front of our own home.
        </p>
      </div>

      <div class="stats mt-5" data-reveal>
        {
          stats.map((s) => (
            <div class="stat">
              <span class="stat__no">{s.no}</span>
              <Icon name={s.icon} class="stat__icon" />
              <div class="stat__value">
                {s.value}
                {s.unit && <span style="font-size: 0.4em; letter-spacing: -0.02em; margin-left: 0.15em">{s.unit}</span>}
              </div>
              <div>
                <div class="stat__label">{s.label}</div>
                <div class="stat__sub">{s.sub}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Services ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="02" label="What we do" />
          <h2 class="h2" data-reveal>Storage for every <em class="accent">situation.</em></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">
          Renovating, moving, building or just out of room — one well-built
          unit, delivered to your driveway or jobsite.
        </p>
      </div>

      <div class="svc" data-reveal>
        {
          audiences.map((a, i) => (
            <article class:list={["svc__item", { "is-open": i === 0 }]} tabindex="0" aria-label={a.title}>
              <Image src={a.image} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 900px" format="webp" quality={70} />
              <div class="svc__collapsed">
                <span>
                  <span class="index">({a.index})</span>
                  {a.title}
                </span>
              </div>
              <div class="svc__open">
                <span class="svc__tag">({a.index})</span>
                <h3 class="svc__title">{a.title}</h3>
                <p class="svc__desc">{a.blurb}</p>
                <div class="svc__foot">
                  <span>{a.tags.join(" · ")}</span>
                  <a class="link" href={href(a.slug)}>
                    Explore <Icon name="arrow-right" />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== The unit ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label="The unit" />
          <h2 class="h2" data-reveal>Built to protect. <em class="accent">Designed to look good doing it.</em></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede mb-2">
            Insulated walls and ceiling for inland summers. A wide roll-up
            door. Charcoal siding with cedar-tone trim.
          </p>
          <a class="link" href={href("unit")}>See the unit <Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="masonry">
        {
          work.map((w, i) => (
            <a class:list={["work", w.span]} href={href("unit")} data-reveal="scale" style={`--delay: ${(i % 2) * 90}ms`}>
              <div class:list={["media", "media--hover", "work__media", w.ratio]}>
                <Image src={w.image} alt={w.alt} widths={[700, 1100, 1500]} sizes="(max-width: 860px) 100vw, 700px" format="webp" quality={72} />
                <span class="img-btn">
                  <Icon name="arrow-up-right" />
                </span>
              </div>
              <div class="work__row">
                <span class="work__title">{w.title}</span>
                <span class="work__year">{w.year}</span>
              </div>
              <p class="work__desc">{w.desc}</p>
              <div class="chips">{w.chips.map((c) => <span class="chip">{c}</span>)}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Sizes & pricing ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="04" label="Sizes & pricing" />
          <h2 class="h2" data-reveal>Simple pricing. <em class="accent">No surprises.</em></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede mb-2">
            The price you see is the price you pay. Month to month, keep it as
            long as you need. {business.deliveryFee} delivery and pickup within{" "}
            {business.deliveryRadius} of {business.town}.
          </p>
          <Button href={href("pricing")} label="See full pricing" variant="outline" size="sm" />
        </div>
      </div>

      <SizeTable mode="both" />
      <p class="small muted mt-2" data-reveal>
        Not sure which size? Tell us what you're storing and we'll help you choose when we call.
      </p>
    </div>
  </section>

  <!-- ===================== Process (dark) ===================== -->
  <section class="section section--dark process">
    <div class="process__bg" aria-hidden="true">
      <Image src={images.unitOpenInterior} alt="" widths={[1200, 1800]} sizes="100vw" format="webp" quality={55} />
    </div>
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="05" label="How it works" />
          <h2 class="h2" data-reveal>Four steps. <em class="accent">One phone call.</em></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede muted mb-2">
            No forms that go nowhere, no "call for pricing". Tell us what you
            need and a real person calls you back.
          </p>
          <Button href={href("quote")} label="Get My Free Quote" variant="light" size="sm" />
        </div>
      </div>

      <div class="steps">
        {
          process.map((p, i) => (
            <div class="step" data-reveal style={`--delay: ${i * 80}ms`}>
              <span class="step__no">
                <Icon name="arrow-right" /> 0{i + 1}.
              </span>
              <h3 class="step__title">{p.title}</h3>
              <p class="step__desc">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Beliefs ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="06" label="What we believe" />
          <h2 class="h2" data-reveal>A family business, <em class="accent">not a franchise.</em></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede mb-2">
            We run Northline the way we'd want to be treated: honest prices, a
            real person on the phone, and care for every property we visit.
          </p>
          <a class="link" href={href("about")}>Our story <Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="feature-list" data-reveal>
        {
          beliefs.map((b, i) => (
            <div class="feature">
              <span class="index">(0{i + 1})</span>
              <div>
                <h3 class="feature__title">{b.title}</h3>
                <p class="feature__desc">{b.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="07" label="FAQ" />
          <h2 class="h2 mb-2" data-reveal>Questions, <em class="accent">answered.</em></h2>
          <p class="lede mb-2" data-reveal style="--delay: 80ms">
            Sizes, delivery, permits, buying — the things people ask us most.
          </p>
          <a class="link" href={href("faq")} data-reveal style="--delay: 140ms">
            Ask us anything <Icon name="arrow-right" />
          </a>
        </div>
        <Faq items={homeFaq} />
      </div>
    </div>
  </section>
</Layout>
