---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SizeTable from "../components/SizeTable.astro";
import { images, href, features, business } from "../data/site";

const protects = [
  "Wood furniture from warping and cracking",
  "Electronics and appliances from heat damage",
  "Artwork, photos and paperwork from fading and curling",
  "Clothing and fabrics from that stale, stuffy smell",
];
---

<Layout slug="unit">
  <PageHero
    no="01"
    label="The unit"
    sub="Most portable storage is a metal box. Ours is closer to a small, well-built room — insulated, secure and handsome enough for any driveway."
    image={images.unitOpenInterior}
    alt="A Northline unit with its roll-up door open, showing the lit, wood-lined, insulated interior"
  >
    Built to protect your things. <em class="accent">Designed to look good doing it.</em>
    <Fragment slot="actions">
      <Button href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <!-- Designed for beautiful homes -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="02" label="Designed for beautiful homes" />
          <h2 class="h2" data-reveal>Built to sit in front of a home <em class="accent">you're proud of.</em></h2>
        </div>
        <div>
          <p class="intro mb-4" data-reveal>
            Charcoal ribbed siding. Warm cedar-tone trim. Clean, simple lines.
          </p>
          <p class="lede mb-4" data-reveal style="--delay: 80ms">
            We designed Northline units to sit in front of a beautiful home
            without looking out of place — so you're never counting the days
            until it's gone.
          </p>
          <div class="media media--4x3 media--hover" data-reveal="scale">
            <Image src={images.detailBadgeTrim} alt="Close-up of the cedar-tone trim, fasteners and Northline badge" widths={[700, 1100, 1500]} sizes="(max-width: 860px) 100vw, 700px" format="webp" quality={72} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Insulated -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label="Insulated, inside and out" />
          <h2 class="h2" data-reveal>Inland summers are hard on <em class="accent">stored belongings.</em></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">
          Insulated walls and ceiling help keep the inside cooler and more
          stable, which helps protect:
        </p>
      </div>
      <div class="reasons" data-reveal>
        {protects.map((p) => <div class="reason"><span>{p}</span></div>)}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="04" label="Features" />
          <h2 class="h2" data-reveal>What's built in, <em class="accent">and what it means for you.</em></h2>
        </div>
        <table class="table table--2" data-reveal>
          <thead>
            <tr><th>Feature</th><th>What it means for you</th></tr>
          </thead>
          <tbody>
            {features.map((f) => <tr><td>{f.feature}</td><td>{f.benefit}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Sizes -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="05" label="Choose your size" />
          <h2 class="h2" data-reveal>Three sizes. <em class="accent">One build quality.</em></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">
          Not sure which size? Tell us what you're storing and we'll help you
          choose when we call.
        </p>
      </div>
      <SizeTable mode="both" />
    </div>
  </section>

  <!-- Placed with care -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div>
          <Eyebrow no="06" label="Placed with care" />
          <h2 class="h2" data-reveal>Exactly where <em class="accent">you want it.</em></h2>
        </div>
        <div>
          <p class="lede mb-3" data-reveal>
            We deliver to your driveway or jobsite and set the unit exactly where
            you want it — {business.deliveryFee} within {business.deliveryRadius} of{" "}
            {business.town}, and a distance fee quoted upfront beyond that.
          </p>
          <div data-reveal style="--delay: 80ms">
            <Button href={href("quote")} label="Get My Free Quote" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
