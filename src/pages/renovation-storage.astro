---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { images, href } from "../data/site";
import { getPage } from "../lib/content";


const page = await getPage("renovation");
const { t } = page;
---

<Layout slug="renovation-storage">
  <PageHero
    page={page}
    image={images.renovationLoaded}
    alt="A loaded Northline unit on the driveway of a home mid-renovation, furniture wrapped and protected inside"
  >
    <Fragment slot="actions">
      <Button variant="accent" href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="02" label={t("whyLabel")} />
          <h2 class="h2" data-reveal><Title head={t("whyHeading")} accent={t("whyAccent")} /></h2>
        </div>
        <div class="reasons" data-reveal>
          {[1, 2, 3, 4].map((i) => <div class="reason"><span><strong>{t(`reason${i}Lead`)}</strong> {t(`reason${i}Text`)}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div>
          <Eyebrow no="03" label={t("bizLabel")} />
          <h2 class="h2" data-reveal><Title head={t("bizHeading")} accent={t("bizAccent")} /></h2>
        </div>
        <p class="lede" data-reveal style="--delay: 80ms">{t("bizText")}</p>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="04" label={t("howLabel")} />
          <h2 class="h2 mb-3" data-reveal><Title head={t("howHeading")} accent={t("howAccent")} /></h2>
          <div data-reveal style="--delay: 80ms">
            <Button variant="accent" href={href("quote")} label="Get My Free Quote" />
          </div>
        </div>
        <ol class="how" data-reveal>
          {[1, 2, 3, 4].map((i) => t(`how${i}`)).filter(Boolean).map((x) => <li>{x}</li>)}
        </ol>
      </div>
    </div>
  </section>
</Layout>
