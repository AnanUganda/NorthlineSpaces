---
import Layout from "../layouts/Layout.astro";

const year = new Date().getFullYear();
const services = ["Rent", "Buy", "Custom builds"];
---

<Layout>
  <div class="page">
    <div class="glow" aria-hidden="true"></div>

    <header class="top">
      <a class="wordmark" href="/" aria-label="Northline home">Northline</a>
      <span class="locale">Southern California</span>
    </header>

    <main class="hero">
      <p class="eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Premium portable storage
      </p>

      <h1 class="headline">
        Something solid<br />is coming&nbsp;soon.
      </h1>

      <p class="lede">
        Northline builds premium portable storage buildings — insulated, wired,
        and made to last. Rent one by the month, buy one outright, or design a
        custom build for your space.
      </p>

      <ul class="chips" aria-label="What we offer">
        {services.map((s) => <li class="chip">{s}</li>)}
      </ul>

      <form class="notify" id="notify" novalidate>
        <label class="sr-only" for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@email.com"
          required
        />
        <button type="submit">Notify me</button>
      </form>
      <p class="notify-note" id="notify-note" role="status" aria-live="polite">
        Be the first to know when we launch.
      </p>
    </main>

    <footer class="bottom">
      <span>&copy; {year} Northline</span>
      <span class="sep" aria-hidden="true">•</span>
      <span>Portable storage, done right.</span>
    </footer>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 32px;
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 24px 32px;
    overflow: hidden;
  }

  /* Soft ambient glow behind the hero */
  .glow {
    position: fixed;
    top: -18%;
    left: 50%;
    width: min(900px, 120vw);
    height: min(900px, 120vw);
    transform: translateX(-50%);
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent) 24%, transparent),
      transparent 62%
    );
    z-index: 0;
    pointer-events: none;
    filter: blur(6px);
  }

  .top,
  .hero,
  .bottom {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .wordmark {
    font-family: Fraunces, Georgia, serif;
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink);
  }

  .locale {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* Hero */
  .hero {
    align-self: center;
    max-width: var(--maxw);
    padding: 8px 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 22px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .headline {
    font-family: Fraunces, Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 7.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0 0 24px;
  }

  .lede {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--muted);
    max-width: 48ch;
    margin: 0 0 28px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
  }

  .chip {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 7px 14px;
    border-radius: 999px;
  }

  /* Notify form */
  .notify {
    display: flex;
    gap: 10px;
    max-width: 440px;
  }

  .notify input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 13px 15px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .notify input::placeholder {
    color: color-mix(in srgb, var(--muted) 80%, transparent);
  }

  .notify input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .notify button {
    flex: 0 0 auto;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 13px 22px;
    cursor: pointer;
    transition: transform 0.1s ease, filter 0.15s ease;
  }

  .notify button:hover {
    filter: brightness(1.06);
  }

  .notify button:active {
    transform: translateY(1px);
  }

  .notify button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .notify-note {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  .notify-note.ok {
    color: var(--accent);
    font-weight: 500;
  }

  /* Footer */
  .bottom {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
  }

  .sep {
    opacity: 0.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 560px) {
    .page {
      padding: 22px 18px 26px;
      gap: 26px;
    }
    .notify {
      flex-direction: column;
    }
    .notify button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>

<script>
  const form = document.getElementById("notify") as HTMLFormElement | null;
  const input = document.getElementById("email") as HTMLInputElement | null;
  const note = document.getElementById("notify-note");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!input || !note) return;
    if (!input.value || !input.checkValidity()) {
      input.focus();
      note.textContent = "Please enter a valid email address.";
      note.classList.remove("ok");
      return;
    }
    // Front-end only for now — no list is wired up yet.
    note.textContent = "Thanks — we'll be in touch when Northline launches.";
    note.classList.add("ok");
    form.reset();
  });
</script>
