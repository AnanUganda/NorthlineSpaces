---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SizeTable from "../components/SizeTable.astro";
import { images, href } from "../data/site";
import { getPage } from "../lib/content";


const page = await getPage("buy");
const { t } = page;
---

<Layout slug="buy">
  <PageHero
    page={page}
    image={images.gardenWorkshop}
    alt="A Northline unit in a backyard garden with its side door open on a tidy workshop"
  >
    <Fragment slot="actions">
      <Button variant="accent" href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("unit")}>See the unit <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="02" label={t("usesLabel")} />
          <h2 class="h2" data-reveal><Title head={t("usesHeading")} accent={t("usesAccent")} /></h2>
        </div>
        <div class="reasons" data-reveal>
          {[1, 2, 3, 4, 5].map((i) => t(`use${i}`)).filter(Boolean).map((x) => <div class="reason"><span>{x}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label={t("pricesLabel")} />
          <h2 class="h2" data-reveal><Title head={t("pricesHeading")} accent={t("pricesAccent")} /></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">{t("pricesText")}</p>
      </div>
      <SizeTable mode="buy" />
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="feature-list" data-reveal>
        <div class="feature">
          <span class="index">(04)</span>
          <div>
            <h3 class="feature__title">{t("extra1Title")}</h3>
            <p class="feature__desc">{t("extra1Text")}</p>
          </div>
        </div>
        <div class="feature">
          <span class="index">(05)</span>
          <div>
            <h3 class="feature__title">{t("extra2Title")}</h3>
            <p class="feature__desc">{t("extra2Text")}</p>
          </div>
        </div>
        <div class="feature">
          <span class="index">(06)</span>
          <div>
            <h3 class="feature__title">{t("extra3Title")}</h3>
            <p class="feature__desc mb-2">{t("extra3Text")}</p>
            <Button variant="accent" href={href("quote")} label="Get My Free Quote" size="sm" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
