---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { nav, href } from "../data/site";
import { getContent } from "../lib/content";

const { business, site } = await getContent();

const year = new Date().getFullYear();
// One "Explore" list, split over two short columns. Home and Get a Quote are
// left out: the logo goes home and the button below asks for the quote.
const links = nav.filter((n) => n.slug !== "" && n.slug !== "quote");
const half = Math.ceil(links.length / 2);
const tel = business.phone.replace(/[^0-9+]/g, "");
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand brand--on-dark" href={href("")} aria-label="Northline Spaces home">
          <Logo class="brand__mark" star="soft" />
          <span class="brand__text">
            <span class="brand__name">{business.wordmark}</span>
            <span class="brand__sub">{business.tagline}</span>
          </span>
        </a>
        <p class="footer__desc">{site.footerBlurb}</p>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <p class="footer__h">Explore</p>
        <div class="footer__links">
          <ul>{links.slice(0, half).map((n) => <li><a href={href(n.slug)}>{n.label}</a></li>)}</ul>
          <ul>{links.slice(half).map((n) => <li><a href={href(n.slug)}>{n.label}</a></li>)}</ul>
        </div>
      </nav>

      <div class="footer__col footer__contact">
        <p class="footer__h">Get in touch</p>
        <ul>
          {business.phone && <li><a href={`tel:${tel}`}>{business.phone}</a></li>}
          {business.email && <li><a href={`mailto:${business.email}`}>{business.email}</a></li>}
          <li class="footer__meta">{business.hours} · Serving {business.area}</li>
        </ul>
        <Button href={href("quote")} label="Get a Free Quote" size="sm" variant="light" class="footer__btn" />
      </div>
    </div>

    <div class="footer__wordmark" aria-hidden="true">Northline</div>

    <div class="footer__bar">
      <span>&copy; {year} {business.name}</span>
      <span class="footer__credit">
        Site by <a href="https://openbrands.studio" target="_blank" rel="noopener">Open Brands Studio</a>
      </span>
      <a href="#top" class="footer__top">
        Back to top <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>
