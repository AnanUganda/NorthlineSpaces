---
import Layout from "../layouts/Layout.astro";

const year = new Date().getFullYear();
const offerings = ["Rent", "Buy", "Custom builds"];
const colophon = ["Est. 2026", "Southern California", "Portable storage"];
---

<Layout>
  <div class="frame">
    <span class="edge" aria-hidden="true">Coming&nbsp;soon · {year}</span>

    <!-- Masthead -->
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Northline home">Northline</a>
      <span class="status">
        <span class="status__dot" aria-hidden="true"></span>
        In development
      </span>
    </header>

    <!-- Hero -->
    <main class="hero">
      <p class="eyebrow">
        <span class="eyebrow__no">(01)</span>
        <span class="eyebrow__rule" aria-hidden="true"></span>
        Premium portable storage
      </p>

      <h1 class="headline">
        <span class="line"><span>Something <em>solid</em></span></span>
        <span class="line"><span>is coming soon.</span></span>
      </h1>

      <p class="lede">
        Northline builds premium portable storage buildings — insulated, wired,
        and made to last. Rent one by the month, buy one outright, or design a
        custom build for your space.
      </p>

      <ul class="chips" aria-label="What we offer">
        {
          offerings.map((item, i) => (
            <li class="chip">
              <span class="chip__no">0{i + 1}</span>
              {item}
            </li>
          ))
        }
      </ul>

      <form class="notify" id="notify" novalidate>
        <div class="field">
          <label class="sr-only" for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@email.com"
            required
          />
          <button type="submit">
            Notify me
            <svg
              class="arrow"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 8h11M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <p class="note" id="note" role="status" aria-live="polite">
          Be the first to know when we launch. No noise.
        </p>
      </form>
    </main>

    <!-- Colophon -->
    <footer class="colophon">
      <ul class="meta" aria-label="About Northline">
        {colophon.map((c) => <li>{c}</li>)}
      </ul>
      <span class="copy">&copy; {year} Northline</span>
    </footer>
  </div>
</Layout>

<style>
  .frame {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    max-width: 1340px;
    margin-inline: auto;
    padding: clamp(1.4rem, 3.5vw, 2.6rem) var(--gutter)
      clamp(1.4rem, 3vw, 2.2rem);
  }

  /* Vertical edge label */
  .edge {
    position: fixed;
    top: 50%;
    right: clamp(0.5rem, 1.4vw, 1.1rem);
    translate: 0 -50%;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
    user-select: none;
    z-index: 2;
  }

  /* ---- Masthead ---- */
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: clamp(1.1rem, 2.4vw, 1.8rem);
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.5vw, 1.45rem);
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent);
    animation: pulse 2.6s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 50%, transparent);
    }
    70% {
      box-shadow: 0 0 0 9px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* ---- Hero ---- */
  .hero {
    align-self: center;
    padding: clamp(2rem, 7vh, 5rem) 0;
    max-width: 62rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 clamp(1.4rem, 3vw, 2.1rem);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .eyebrow__no {
    color: var(--accent);
  }

  .eyebrow__rule {
    width: clamp(28px, 6vw, 64px);
    height: 1px;
    background: var(--line-strong);
  }

  .headline {
    margin: 0 0 clamp(1.5rem, 3vw, 2.2rem);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.9rem, 9.2vw, 7.4rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .headline em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  /* Masked line reveal */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .line > span {
    display: block;
    translate: 0 110%;
    animation: line-rise 0.95s var(--ease-out) forwards;
  }

  .line:nth-child(1) > span {
    animation-delay: 0.1s;
  }
  .line:nth-child(2) > span {
    animation-delay: 0.22s;
  }

  @keyframes line-rise {
    to {
      translate: 0 0;
    }
  }

  .lede {
    max-width: 44ch;
    margin: 0 0 clamp(1.8rem, 3.5vw, 2.6rem);
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.58;
    color: var(--muted);
    letter-spacing: -0.005em;
  }

  /* Staggered entrance for everything below the headline */
  .lede,
  .chips,
  .notify {
    opacity: 0;
    translate: 0 16px;
    animation: rise 0.8s var(--ease-out) forwards;
  }
  .lede {
    animation-delay: 0.42s;
  }
  .chips {
    animation-delay: 0.52s;
  }
  .notify {
    animation-delay: 0.62s;
  }

  @keyframes rise {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ---- Chips ---- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(2.2rem, 4.5vw, 3.2rem);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 450;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    padding: 8px 15px;
    border-radius: 999px;
    transition:
      border-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .chip__no {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--faint);
    transition: color 0.35s var(--ease-out);
  }

  @media (hover: hover) {
    .chip:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .chip:hover .chip__no {
      color: var(--accent);
    }
  }

  /* ---- Notify ---- */
  .notify {
    max-width: 460px;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1.5px solid var(--line-strong);
    transition: border-color 0.35s var(--ease-out);
  }

  .field:focus-within {
    border-color: var(--accent);
  }

  .field input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: 1.05rem;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 12px 2px;
  }

  .field input::placeholder {
    color: var(--faint);
  }

  .field input:focus {
    outline: none;
  }

  .field button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 10px 2px 10px 12px;
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
  }

  .field button:hover {
    color: var(--accent);
  }

  .field button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  .field button:hover .arrow {
    transform: translateX(4px);
  }

  .note {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--muted);
    letter-spacing: -0.003em;
  }

  .note.is-ok {
    color: var(--accent);
  }

  .note.is-error {
    color: oklch(0.6 0.16 25);
  }

  /* ---- Colophon ---- */
  .colophon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    padding-top: clamp(1.1rem, 2.4vw, 1.8rem);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .meta li {
    position: relative;
  }

  .meta li + li::before {
    content: "";
    position: absolute;
    left: -12px;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--faint);
    transform: translateY(-50%);
  }

  .copy {
    color: var(--faint);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .edge {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .colophon {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  /* Reduced motion: show everything, no transforms */
  @media (prefers-reduced-motion: reduce) {
    .line > span,
    .lede,
    .chips,
    .notify {
      opacity: 1;
      translate: 0 0;
      animation: none;
    }
    .status__dot {
      animation: none;
    }
  }
</style>

<script>
  const form = document.getElementById("notify") as HTMLFormElement | null;
  const input = document.getElementById("email") as HTMLInputElement | null;
  const note = document.getElementById("note");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!input || !note) return;

    if (!input.value || !input.checkValidity()) {
      input.focus();
      note.textContent = "Please enter a valid email address.";
      note.classList.remove("is-ok");
      note.classList.add("is-error");
      return;
    }

    // Front-end only for now — not yet wired to Wix Forms.
    note.textContent = "Thanks — we'll be in touch when Northline launches.";
    note.classList.remove("is-error");
    note.classList.add("is-ok");
    form.reset();
  });
</script>
