---
import Img from "../components/Img.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { images, href } from "../data/site";
import { getContent, getPage } from "../lib/content";

const { business } = await getContent();
const page = await getPage("about");
const { t } = page;
const home = await getPage("home"); // the three beliefs are edited on Page: Home
const ownerPhoto = page.image("ownerPhoto");
---

<Layout slug="about">
  <PageHero
    page={page}
    image={images.estateAerial}
    alt="Aerial view of a Northline unit on the paved courtyard of a hillside estate at golden hour"
  >
    <Fragment slot="actions">
      <Button href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("unit")}>See the unit <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <!-- Our story -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="02" label={t("storyLabel")} />
          <h2 class="h2" data-reveal><Title head={t("storyHeading")} accent={t("storyAccent")} /></h2>
        </div>
        <div class="prose">
          <figure class="owner" data-reveal="scale">
            {
              ownerPhoto ? (
                <div class="media media--4x3">
                  <img src={ownerPhoto} alt={`${t("ownerName")}, ${business.name}`} width="1200" height="900" loading="eager" decoding="async" />
                </div>
              ) : (
                <div class="media media--4x3">
                  <Img src={images.gardenWorkshop} alt="Northline storage unit in a landscaped garden — placeholder for the family photo" sizes="(min-width: 900px) 55vw, 100vw" />
                </div>
              )
            }
            <figcaption class="owner__caption">
              <span class="label">{ownerPhoto ? t("ownerName") : "Northline Spaces"}</span>
              <span class="small muted">{ownerPhoto ? t("ownerCaption") : "Placeholder image · Family photo coming soon"}</span>
            </figcaption>
          </figure>

          <p class="intro mb-4" data-reveal>{t("storyIntro")}</p>
          <p class="lede" data-reveal style="--delay: 60ms">{t("storyText1")}</p>
          <p class="lede" data-reveal style="--delay: 120ms">{t("storyText2")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beliefs -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label={t("beliefsLabel")} />
          <h2 class="h2" data-reveal><Title head={t("beliefsHeading")} accent={t("beliefsAccent")} /></h2>
        </div>
      </div>
      <div class="feature-list" data-reveal>
        {
          [1, 2, 3].map((i) => (
            <div class="feature">
              <span class="index">(0{i})</span>
              <div>
                <h3 class="feature__title">{home.t(`belief${i}Title`)}</h3>
                <p class="feature__desc">{home.t(`belief${i}Text`)}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The name -->
  <section class="section section--dark process">
    <div class="process__bg" aria-hidden="true">
      <Img src={images.detailBadgeTrim} alt="" widths={[1200, 1800]} sizes="100vw" format="webp" quality={55} />
    </div>
    <div class="container">
      <div class="split split--even" style="align-items: center">
        <div>
          <Eyebrow no="04" label={t("nameLabel")} />
          <h2 class="h2 mb-3" data-reveal><Title head={t("nameHeading")} accent={t("nameAccent")} /></h2>
          <p class="lede muted mb-3" data-reveal style="--delay: 80ms">{t("nameText")}</p>
          <div data-reveal style="--delay: 140ms">
            <Button href={href("quote")} label="Get My Free Quote" variant="light" />
          </div>
        </div>
        <div data-reveal style="--delay: 120ms; justify-self: center">
          <Logo class="about-mark" star="soft" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .owner {
    margin: 0 0 clamp(28px, 4vw, 44px);
  }

  .owner__caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    margin-top: 12px;
  }

  :global(.about-mark) {
    width: clamp(160px, 28vw, 320px);
    height: auto;
    color: var(--on-dark);
  }
</style>
