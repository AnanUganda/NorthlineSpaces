---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { images, href } from "../data/site";
import { getPage } from "../lib/content";


const page = await getPage("moving");
const { t } = page;
---

<Layout slug="moving">
  <PageHero
    page={page}
    image={images.unitOpenInterior}
    alt="A Northline unit with the roll-up door open, ready to load at ground level"
  >
    <Fragment slot="actions">
      <Button variant="accent" href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="02" label={t("waysLabel")} />
          <h2 class="h2" data-reveal><Title head={t("waysHeading")} accent={t("waysAccent")} /></h2>
        </div>
      </div>
      <table class="table" data-reveal>
        <thead>
          <tr><th></th><th>{t("waysColA")}</th><th>{t("waysColB")}</th></tr>
        </thead>
        <tbody>
          {[1, 2, 3, 4].map((i) => <tr><td>{t(`row${i}Label`)}</td><td>{t(`row${i}A`)}</td><td>{t(`row${i}B`)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="03" label={t("whyLabel")} />
          <h2 class="h2" data-reveal><Title head={t("whyHeading")} accent={t("whyAccent")} /></h2>
        </div>
        <div class="reasons" data-reveal>
          {[1, 2, 3, 4].map((i) => <div class="reason"><span><strong>{t(`reason${i}Lead`)}</strong> {t(`reason${i}Text`)}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="split">
        <div>
          <Eyebrow no="04" label={t("distanceLabel")} />
          <h2 class="h2" data-reveal><Title head={t("distanceHeading")} accent={t("distanceAccent")} /></h2>
        </div>
        <div>
          <p class="lede mb-3" data-reveal>{t("distanceText")}</p>
          <div data-reveal style="--delay: 80ms">
            <Button variant="accent" href={href("quote")} label="Get My Free Quote" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
