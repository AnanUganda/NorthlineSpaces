---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SizeTable from "../components/SizeTable.astro";
import { images, href } from "../data/site";
import { getPage } from "../lib/content";


const page = await getPage("pricing");
const { t } = page;
---

<Layout slug="pricing">
  <PageHero
    page={page}
    image={images.unitStudioFront}
    alt="Front elevation of a Northline storage unit"
  >
    <Fragment slot="actions">
      <Button href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("unit")}>See the unit <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <!-- Rent -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="02" label={t("rentLabel")} />
          <h2 class="h2" data-reveal><Title head={t("rentHeading")} accent={t("rentAccent")} /></h2>
        </div>
        <p class="lede section-head__aside" data-reveal style="--delay: 80ms">{t("rentText")}</p>
      </div>
      <SizeTable mode="rent" />
    </div>
  </section>

  <!-- Buy -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow no="03" label={t("buyLabel")} />
          <h2 class="h2" data-reveal><Title head={t("buyHeading")} accent={t("buyAccent")} /></h2>
        </div>
        <div class="section-head__aside" data-reveal style="--delay: 80ms">
          <p class="lede mb-2">{t("buyText")}</p>
          <a class="link" href={href("buy")}>{t("buyLink")} <Icon name="arrow-right" /></a>
        </div>
      </div>
      <SizeTable mode="buy" />
    </div>
  </section>

  <!-- Delivery + full service + included -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="feature-list" data-reveal>
        <div class="feature">
          <span class="index">(04)</span>
          <div>
            <h3 class="feature__title">{t("deliveryTitle")}</h3>
            <p class="feature__desc mb-2"><strong>{t("deliveryNearLead")}</strong> {t("deliveryNearText")}</p>
            <p class="feature__desc"><strong>{t("deliveryFarLead")}</strong> {t("deliveryFarText")}</p>
          </div>
        </div>
        <div class="feature">
          <span class="index">(05)</span>
          <div>
            <h3 class="feature__title">{t("fullServiceTitle")}</h3>
            <p class="feature__desc">{t("fullServiceText")}</p>
          </div>
        </div>
        <div class="feature">
          <span class="index">(06)</span>
          <div>
            <h3 class="feature__title">{t("includedTitle")}</h3>
            <ul class="feature__desc" style="display: grid; gap: 8px">
              {[1, 2, 3, 4].map((i) => t(`included${i}`)).filter(Boolean).map((x) => <li>— {x}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
