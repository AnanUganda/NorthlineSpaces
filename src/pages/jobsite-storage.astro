---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Title from "../components/Title.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { images, href } from "../data/site";
import { getPage } from "../lib/content";

const page = await getPage("jobsite");
const { t } = page;
---

<Layout slug="jobsite-storage">
  <PageHero
    page={page}
    image={images.unitStudioAngle}
    alt="Three-quarter view of a Northline unit showing the window and walk-in side door"
  >
    <Fragment slot="actions">
      <Button href={href("quote")} label="Get My Free Quote" />
      <a class="link" href={href("pricing")}>See pricing <Icon name="arrow-right" /></a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__sticky">
          <Eyebrow no="02" label={t("prosLabel")} />
          <h2 class="h2" data-reveal><Title head={t("prosHeading")} accent={t("prosAccent")} /></h2>
        </div>
        <div class="reasons" data-reveal>
          {[1, 2, 3, 4, 5].map((i) => <div class="reason"><span><strong>{t(`reason${i}Lead`)}</strong> {t(`reason${i}Text`)}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="split">
        <div>
          <Eyebrow no="03" label={t("termsLabel")} />
          <h2 class="h2" data-reveal><Title head={t("termsHeading")} accent={t("termsAccent")} /></h2>
        </div>
        <div>
          <p class="lede mb-3" data-reveal>{t("termsText")}</p>
          <div data-reveal style="--delay: 80ms">
            <Button href={href("quote")} label="Get My Free Quote" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
